bool is_fov ( vectors::vector2 vec1 , vectors::vector2 vec2, int radius ) {
 int x = vec1.x;
 int y = vec1.y;
 
 int x0 = vec2.x;
 int y0 = vec2.y;
 if ( ( pow ( x - x0 , 2 ) + pow ( y - y0 , 2 ) ) <= pow ( radius , 2 ) ) {
  return true;
 } else {
  return false;
 }
}

